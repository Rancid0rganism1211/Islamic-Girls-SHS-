{
  "name": "Timetable",
  "type": "object",
  "properties": {
    "day_of_week": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ]
    },
    "time_slot": {
      "type": "string",
      "description": "e.g. 8:00 - 9:00 AM"
    },
    "form_level": {
      "type": "string",
      "enum": [
        "Form 1",
        "Form 2",
        "Form 3"
      ]
    },
    "program": {
      "type": "string",
      "enum": [
        "General Arts",
        "Science",
        "Home Economics",
        "Business"
      ]
    },
    "subject_name": {
      "type": "string"
    }
  },
  "required": [
    "day_of_week",
    "time_slot",
    "form_level",
    "program",
    "subject_name"
  ]
}