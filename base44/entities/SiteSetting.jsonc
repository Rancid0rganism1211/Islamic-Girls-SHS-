{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Unique key like school_fees, reopening_date, welcome_message"
    },
    "setting_value": {
      "type": "string",
      "description": "The value for this setting"
    },
    "setting_label": {
      "type": "string",
      "description": "Human-readable label for admin UI"
    }
  },
  "required": [
    "setting_key",
    "setting_value",
    "setting_label"
  ]
}