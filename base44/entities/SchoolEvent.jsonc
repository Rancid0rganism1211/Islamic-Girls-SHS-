{
  "name": "SchoolEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the event"
    },
    "event_time": {
      "type": "string",
      "description": "Time of event e.g. 9:00 AM"
    },
    "location": {
      "type": "string",
      "description": "Where the event takes place"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "event_date"
  ]
}